---
import Icon from './Icon.astro';
import { t } from '../i18n';
import type { Lang } from '../i18n/types';
interface Props { lang: Lang }
const d = t(Astro.props.lang).features;
---
<section id="features" class="section">
  <div class="wrap">
    <div class="section-head" data-reveal><div><h2>{d.title}</h2><p>{d.lead}</p></div></div>
    <ul class="grid">
      {d.items.map((f, i) => (
        <li data-reveal style={`--i:${i % 4}`}>
          <span class="ico"><Icon name={f.icon} /></span>
          <h3>{f.title}</h3>
          <p>{f.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 40px 32px; }
  li { border-top: 1px solid var(--line); padding-top: 22px; position: relative; }
  li::before { content: ''; position: absolute; top: -1px; left: 0; width: 0; height: 1px; background: var(--gold); transition: width .5s var(--ease-out); }
  li:hover::before { width: 100%; }
  .ico { transition: transform .35s var(--ease-spring); }
  li:hover .ico { transform: translateY(-4px) rotate(-6deg); }
  .ico { display: inline-grid; place-items: center; width: 36px; height: 36px; background: var(--accent); color: var(--accent-ink); margin-bottom: 16px; }
  .ico :global(svg) { width: 20px; height: 20px; }
  li:nth-child(4n + 2) .ico, li:nth-child(4n + 4) .ico { background: var(--gold); color: var(--bg); }
  h3 { margin-bottom: 8px; }
  p { color: var(--ink-2); font-size: 14px; }
  @media (max-width: 960px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
</style>
