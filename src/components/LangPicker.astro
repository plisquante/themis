---
import Icon from './Icon.astro';
import { t, LANGUAGES } from '../i18n';
import type { Lang } from '../i18n/types';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<details class="lang" data-lang-picker>
  <summary class="icon-btn" aria-label={d.lang.label} title={d.lang.label}>
    <Icon name="globe" /><span class="cur notranslate" translate="no" data-lang-current>{lang.toUpperCase()}</span>
  </summary>
  <div class="menu notranslate" translate="no" role="menu">
    {LANGUAGES.map((l) => <button type="button" role="menuitemradio" data-lang-pick={l.code} aria-checked="false">{l.name}</button>)}
  </div>
</details>

<style>
  .lang { position: relative; }
  summary { list-style: none; display: flex; align-items: center; gap: 6px; padding: 0 8px; height: 36px; cursor: pointer; color: var(--ink-2); }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--ink); }
  summary :global(svg) { width: 18px; height: 18px; }
  .cur { font-size: 12px; font-weight: 600; }
  .menu {
    position: absolute; right: 0; top: 44px; z-index: 60; width: 220px; max-height: min(70vh, 460px); overflow-y: auto;
    background: var(--surface); border: 1px solid var(--line); box-shadow: 6px 6px 0 var(--line); padding: 6px; display: grid;
    animation: drop .18s var(--ease-out);
  }
  .menu button { text-align: left; background: none; border: 0; color: var(--ink-2); font: inherit; font-size: 13.5px; padding: 8px 10px; cursor: pointer; }
  .menu button:hover, .menu button:focus-visible { background: var(--bg-2); color: var(--ink); }
  .menu button[aria-checked='true'] { color: var(--gold-2); box-shadow: inset 2px 0 0 var(--gold); }
  @keyframes drop { from { opacity: 0; transform: translateY(-6px); } }
</style>
