---
import { t } from '../i18n';
import type { Lang } from '../i18n/types';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).demo;
---
<section id="demo" class="section alt">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <div><h2>{d.title}</h2><p>{d.lead}</p></div>
    </div>
    <div class="demo" data-demo data-lang={lang} data-reveal>
      <div class="console">
        <div class="bar">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="where">survival · Paper 1.21.11 · Themis 1.0.0</span>
          <button type="button" class="reset" data-reset>{d.reset}</button>
        </div>
        <ol class="log notranslate" translate="no" aria-live="polite" aria-label="Console"></ol>
        <form class="prompt" autocomplete="off">
          <label class="visually-hidden" for={`cmd-${lang}`}>Command</label>
          <span aria-hidden="true">&gt;</span>
          <input id={`cmd-${lang}`} type="text" spellcheck="false" placeholder={d.placeholder} />
          <button class="btn primary small" type="submit">{d.run}</button>
        </form>
      </div>
      <div class="side">
        <div class="tabs" role="tablist" aria-label="Output">
          <button role="tab" type="button" aria-selected="true" data-tab="screen" id={`t-screen-${lang}`} aria-controls={`p-screen-${lang}`}>{d.tabs.screen}</button>
          <button role="tab" type="button" aria-selected="false" tabindex="-1" data-tab="stream" id={`t-stream-${lang}`} aria-controls={`p-stream-${lang}`}>{d.tabs.stream}</button>
          <button role="tab" type="button" aria-selected="false" tabindex="-1" data-tab="discord" id={`t-discord-${lang}`} aria-controls={`p-discord-${lang}`}>{d.tabs.discord}</button>
        </div>
        <div class="pane" role="tabpanel" data-pane="screen" id={`p-screen-${lang}`} aria-labelledby={`t-screen-${lang}`}><p class="idle">{d.screenIdle}</p></div>
        <div class="pane stream" role="tabpanel" data-pane="stream" id={`p-stream-${lang}`} aria-labelledby={`t-stream-${lang}`} hidden><p class="idle">{d.streamIdle}</p></div>
        <div class="pane discord" role="tabpanel" data-pane="discord" id={`p-discord-${lang}`} aria-labelledby={`t-discord-${lang}`} hidden><p class="idle">{d.discordIdle}</p></div>
      </div>
    </div>
    <div class="chips notranslate" translate="no">
      {d.chips.map((c) => <button type="button" class="chip" data-chip={c}>{c}</button>)}
    </div>
    <p class="hint">{d.hint}</p>
  </div>
</section>

<script>
  import { mountDemo } from '../scripts/demo';
  document.querySelectorAll<HTMLElement>('[data-demo]').forEach(mountDemo);
</script>

<style>
  .demo { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 20px; align-items: stretch; }
  .console, .side { border: 1px solid var(--line); box-shadow: 6px 6px 0 0 var(--line); min-width: 0; }
  .console { background: var(--term-bg); color: var(--term-ink); display: flex; flex-direction: column; height: 460px; }
  .bar { display: flex; align-items: center; gap: 12px; padding: 10px 14px; border-bottom: 1px solid color-mix(in srgb, var(--term-ink) 14%, transparent); font-size: 12px; }
  .dots { display: flex; gap: 6px; }
  .dots i { width: 9px; height: 9px; background: color-mix(in srgb, var(--term-ink) 25%, transparent); }
  .dots i:first-child { background: var(--accent); }
  .where { opacity: .6; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .reset { margin-left: auto; background: none; border: 0; color: inherit; opacity: .7; font: inherit; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .reset:hover { opacity: 1; }
  .log { list-style: none; margin: 0; padding: 14px 16px; overflow-y: auto; flex: 1; font-size: 13px; line-height: 1.7; scrollbar-width: thin; }
  .log :global(li) { white-space: pre-wrap; word-break: break-word; }
  .log :global(.echo) { margin-top: 8px; }
  .log :global(.cmd) { color: color-mix(in srgb, var(--term-ink) 60%, transparent); }
  .log :global(.accent) { color: var(--accent-2); font-weight: 700; }
  .log :global(.muted) { color: color-mix(in srgb, var(--term-ink) 55%, transparent); }
  .log :global(.text) { color: var(--term-ink); }
  .log :global(.gold) { color: var(--gold); }
  .log :global(.good) { color: var(--good); }
  .log :global(.bad) { color: var(--bad); }
  .log :global(.has-tip) { cursor: help; text-decoration: underline dotted; text-underline-offset: 3px; }
  .prompt { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-top: 1px solid color-mix(in srgb, var(--term-ink) 14%, transparent); }
  .prompt span { color: var(--gold); }
  .prompt input { flex: 1; min-width: 0; background: none; border: 0; color: var(--term-ink); font: inherit; font-size: 14px; outline: none; }
  .prompt input::placeholder { color: color-mix(in srgb, var(--term-ink) 35%, transparent); }
  .prompt:focus-within { box-shadow: inset 0 2px 0 var(--gold); }

  .side { background: var(--surface); display: flex; flex-direction: column; height: 460px; }
  .tabs { display: flex; border-bottom: 1px solid var(--line); overflow-x: auto; }
  .tabs button {
    position: relative; flex: 1; padding: 12px 10px; background: none; border: 0; border-right: 1px solid var(--line);
    color: var(--ink-2); font: inherit; font-size: 12.5px; cursor: pointer; white-space: nowrap;
  }
  .tabs button:last-child { border-right: 0; }
  .tabs button[aria-selected='true'] { color: var(--ink); background: var(--bg-2); box-shadow: inset 0 -2px 0 var(--accent); }
  .tabs button:global(.ping)::after { content: ''; position: absolute; top: 9px; right: 9px; width: 6px; height: 6px; background: var(--gold); }
  .pane { flex: 1; overflow-y: auto; padding: 16px; font-size: 13px; }
  .idle { color: var(--ink-3); }

  .pane :global(.mc-screen) {
    min-height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 6px;
    background: var(--term-bg); color: var(--term-ink); padding: 24px 16px; margin: -16px;
    background-image: linear-gradient(45deg, color-mix(in srgb, var(--term-ink) 4%, transparent) 25%, transparent 25%, transparent 75%, color-mix(in srgb, var(--term-ink) 4%, transparent) 75%);
    background-size: 16px 16px;
  }
  .pane :global(.mc-dis) { opacity: .55; font-size: 12px; margin-bottom: 8px; }
  .pane :global(.mc-title) { color: var(--accent-2); font-weight: 800; letter-spacing: .08em; }
  .pane :global(.mc-lead) { margin: 6px 0 10px; }
  .pane :global(.mc-screen dl) { margin: 0; display: grid; gap: 2px; }
  .pane :global(.mc-screen dl div) { display: flex; gap: 10px; justify-content: center; }
  .pane :global(.mc-screen dt) { opacity: .55; }
  .pane :global(.mc-screen dd) { margin: 0; }
  .pane :global(.mc-screen dd.gold), .pane :global(.mc-appeal) { color: var(--gold); }
  .pane :global(.mc-appeal) { margin-top: 12px; font-size: 12px; }
  .pane :global(.mc-chat) { background: var(--term-bg); color: var(--term-ink); margin: -16px; min-height: calc(100% + 32px); padding: 16px; display: flex; flex-direction: column; justify-content: flex-end; gap: 4px; }
  .pane :global(.mc-label) { opacity: .5; font-size: 11px; margin-bottom: auto; }
  .pane :global(.mc-msg) { opacity: .6; }
  .pane :global(.mc-bad) { color: var(--bad); }
  .pane :global(.mc-gold) { color: var(--gold); }
  .pane :global(.mc-good) { color: var(--good); }

  .stream :global(.frame) { border-bottom: 1px dashed var(--line); padding-bottom: 10px; margin-bottom: 10px; }
  .stream :global(.ev) { color: var(--accent-2); font-weight: 600; }
  .stream :global(.data) { margin: 4px 0 0; font-size: 11.5px; line-height: 1.5; color: var(--ink-2); white-space: pre-wrap; word-break: break-all; }

  .discord { background: color-mix(in srgb, var(--surface) 70%, var(--bg)); }
  .discord :global(.embed) { border-left: 4px solid var(--accent); background: var(--bg-2); padding: 10px 12px; margin-bottom: 12px; }
  .discord :global(.t-mute), .discord :global(.t-warn) { border-left-color: var(--gold); }
  .discord :global(.t-kick), .discord :global(.t-note) { border-left-color: var(--ink-3); }
  .discord :global(.t-revoked) { border-left-color: var(--good); }
  .discord :global(.e-head) { display: flex; gap: 6px; align-items: center; font-size: 12px; font-weight: 600; }
  .discord :global(.e-tag) { font-size: 9px; padding: 0 4px; background: var(--accent); color: var(--accent-ink); }
  .discord :global(.e-title) { font-size: 14px; margin: 6px 0 8px; }
  .discord :global(.e-fields) { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 12px; margin: 0; }
  .discord :global(.e-fields dt) { font-size: 11px; color: var(--ink-2); font-weight: 600; }
  .discord :global(.e-fields dd) { margin: 0; font-size: 12.5px; word-break: break-word; }
  .discord :global(.e-foot) { margin-top: 8px; font-size: 11px; color: var(--ink-3); }

  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 28px; }
  .chip {
    font: inherit; font-size: 12.5px; padding: 6px 10px; cursor: pointer;
    background: var(--surface); color: var(--ink); border: 1px solid var(--line);
  }
  .chip:hover { border-color: var(--gold); color: var(--gold); }
  .hint { margin-top: 12px; font-size: 12px; color: var(--ink-3); }
  @media (max-width: 900px) {
    .demo { grid-template-columns: 1fr; }
    .console { height: 380px; }
    .side { height: 360px; }
  }
</style>
