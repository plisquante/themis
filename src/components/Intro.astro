---
// Opening sequence, first visit per session only (html.intro-play is set in <head>).
// Seal blooms in with rings and sparks, the name draws out, then the curtains part onto the hero.
import { asset } from '../i18n';
const sparks = Array.from({ length: 28 }, (_, i) => {
  const a = (i / 28) * Math.PI * 2 + (i % 2) * 0.11;
  const r = 150 + ((i * 37) % 90);
  return { x: Math.round(Math.cos(a) * r), y: Math.round(Math.sin(a) * r), d: 260 + ((i * 53) % 220), gold: i % 3 !== 0 };
});
---
<div class="intro" aria-hidden="true" data-intro>
  <div class="half top"></div>
  <div class="half bottom"></div>
  <div class="core">
    <div class="rings"><i></i><i></i><i></i></div>
    <div class="sparks">{sparks.map((s) => <i class={s.gold ? 'g' : ''} style={`--x:${s.x}px;--y:${s.y}px;--d:${s.d}ms`}></i>)}</div>
    <img src={asset('logo.png')} width="168" height="168" alt="" />
    <p class="word notranslate" translate="no">THEMIS</p>
    <div class="bar"><i></i></div>
  </div>
</div>

<script>
  const intro = document.querySelector<HTMLElement>('[data-intro]');
  if (intro && document.documentElement.classList.contains('intro-play')) {
    const done = () => { intro.classList.add('gone'); setTimeout(() => intro.remove(), 400); };
    const t = setTimeout(done, 2100);
    const skip = () => { clearTimeout(t); done(); removeEventListener('keydown', skip); };
    intro.addEventListener('click', skip);
    addEventListener('keydown', skip, { once: true });
  } else {
    intro?.remove();
  }
</script>

<style>
  .intro { display: none; }
  :global(html.intro-play) .intro {
    display: grid; place-items: center; position: fixed; inset: 0; z-index: 200; cursor: pointer;
    animation: vanish 0s linear 1.75s forwards;
  }
  .intro.gone { display: none !important; }
  .half { position: absolute; left: 0; right: 0; height: 50.5%; background: var(--bg); animation: part .75s var(--ease-out) .95s forwards; }
  .half.top { top: 0; border-bottom: 1px solid color-mix(in srgb, var(--gold) 40%, transparent); }
  .half.bottom { bottom: 0; --to: 100%; border-top: 1px solid color-mix(in srgb, var(--gold) 40%, transparent); }
  .half.top { --to: -100%; }
  .core { position: relative; display: grid; justify-items: center; gap: 18px; animation: lift .45s ease-in .9s forwards; }
  img { width: 168px; height: 168px; border-radius: 50%; position: relative; z-index: 2;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--gold) 50%, transparent), 0 0 80px color-mix(in srgb, var(--glow) 70%, transparent);
    animation: bloom .8s var(--ease-spring) both; }
  .rings { position: absolute; top: 84px; left: 50%; width: 0; height: 0; z-index: 1; }
  .rings i { position: absolute; left: -84px; top: -84px; width: 168px; height: 168px; border-radius: 50%;
    border: 2px solid var(--gold); opacity: 0; animation: ring 1.1s var(--ease-out) forwards; }
  .rings i:nth-child(2) { animation-delay: .18s; border-color: var(--accent-2); }
  .rings i:nth-child(3) { animation-delay: .36s; }
  .sparks { position: absolute; top: 84px; left: 50%; width: 0; height: 0; z-index: 1; }
  .sparks i { position: absolute; width: 6px; height: 6px; background: var(--accent-2); opacity: 0;
    animation: spark .9s var(--ease-out) var(--d) forwards; }
  .sparks i.g { background: var(--gold-2); }
  .word { margin: 0; font: 700 15px 'Geist Variable', sans-serif; color: var(--gold-2); letter-spacing: .2em; opacity: 0;
    animation: word .7s var(--ease-out) .35s forwards; }
  .bar { width: 180px; height: 2px; background: var(--line); overflow: hidden; }
  .bar i { display: block; height: 100%; width: 100%; background: linear-gradient(90deg, var(--accent), var(--gold-2)); transform-origin: left;
    transform: scaleX(0); animation: fill .85s var(--ease-out) .1s forwards; }
  @keyframes bloom { from { transform: scale(.35) rotate(-25deg); filter: blur(14px) brightness(2); opacity: 0; } to { transform: none; filter: none; opacity: 1; } }
  @keyframes ring { 0% { transform: scale(.7); opacity: .9; } 100% { transform: scale(2.6); opacity: 0; } }
  @keyframes spark { 0% { transform: translate(0, 0) scale(1.4); opacity: 1; } 100% { transform: translate(var(--x), var(--y)) scale(.4); opacity: 0; } }
  @keyframes word { from { opacity: 0; letter-spacing: .1em; } to { opacity: 1; letter-spacing: .85em; } }
  @keyframes fill { to { transform: scaleX(1); } }
  @keyframes lift { to { transform: translateY(-40px) scale(.92); opacity: 0; } }
  @keyframes part { to { transform: translateY(var(--to)); } }
  @keyframes vanish { to { visibility: hidden; pointer-events: none; } }
</style>
