---
import { t, url, asset, BUY_URL, GITHUB_URL, DISCORD_URL } from '../i18n';
import type { Lang } from '../i18n/types';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const year = 2026;
---
<footer class="footer">
  <div class="wrap grid">
    <div class="about">
      <img src={asset('logo.png')} width="56" height="56" alt="" loading="lazy" />
      <p class="tag">{d.footer.tagline}</p>
    </div>
    <div>
      <h3>{d.footer.product}</h3>
      <a href={`${url('', lang)}#features`}>{d.nav.features}</a>
      <a href={`${url('', lang)}#demo`}>{d.nav.demo}</a>
      <a href={`${url('', lang)}#pricing`}>{d.nav.pricing}</a>
      <a href={BUY_URL}>{d.nav.buy}</a>
    </div>
    <div>
      <h3>{d.footer.resources}</h3>
      <a href={url('docs/', lang)}>{d.nav.docs}</a>
      <a href={`${url('docs/', lang)}#rest`}>REST API</a>
      <a href={`${url('docs/', lang)}#java-api`}>Java API</a>
      <a href={GITHUB_URL}>GitHub</a>
    </div>
    <div>
      <h3>{d.footer.legal}</h3>
      <a href={`${GITHUB_URL}/blob/main/LICENSE.md`}>{d.footer.license}</a>
      <a href={DISCORD_URL}>{d.footer.support}</a>
    </div>
  </div>
  <div class="wrap base">© {year} Themis. {d.footer.rights}</div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); background: var(--bg-2); padding: 56px 0 28px; }
  .grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 32px; }
  .about img { border-radius: 50%; }
  .tag { margin-top: 14px; font: 600 1.15rem 'Geist Variable', sans-serif; letter-spacing: -.02em; }
  h3 { font-size: 14px; margin-bottom: 12px; color: var(--ink); }
  .grid a { display: block; color: var(--ink-2); text-decoration: none; font-size: 14px; padding: 3px 0; }
  .grid a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; }
  .base { margin-top: 48px; padding-top: 20px; border-top: 1px solid var(--line); color: var(--ink-3); font-size: 13px; }
  @media (max-width: 760px) { .grid { grid-template-columns: 1fr 1fr; } .about { grid-column: 1 / -1; } }
</style>
