---
import { t } from '../i18n';
import type { Lang } from '../i18n/types';
interface Props { lang: Lang }
const items = t(Astro.props.lang).ticker;
const row = [...items, ...items];
---
<div class="ticker" aria-hidden="true">
  <div class="track">
    {row.map((x) => <span class:list={[{ cmd: x.startsWith('/') }]} translate={x.startsWith('/') ? 'no' : undefined}>{x}</span>)}
  </div>
</div>

<style>
  .ticker { border-block: 1px solid var(--line); background: var(--bg-2); overflow: hidden; padding: 14px 0;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .track { display: flex; gap: 44px; width: max-content; animation: scroll 46s linear infinite; }
  .ticker:hover .track { animation-play-state: paused; }
  span { font-size: 14px; color: var(--ink-2); white-space: nowrap; display: inline-flex; align-items: center; gap: 44px; }
  span::after { content: ''; width: 6px; height: 6px; background: var(--accent); }
  .cmd { color: var(--gold-2); font-weight: 600; }
  @keyframes scroll { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .track { animation: none; } }
</style>
