---
import Hero from './Hero.astro';
import Ticker from './Ticker.astro';
import Demo from './Demo.astro';
import Features from './Features.astro';
import Ladder from './Ladder.astro';
import Developers from './Developers.astro';
import Compare from './Compare.astro';
import Install from './Install.astro';
import Pricing from './Pricing.astro';
import type { Lang } from '../i18n/types';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Hero lang={lang} />
<Ticker lang={lang} />
<Demo lang={lang} />
<Features lang={lang} />
<Ladder lang={lang} />
<Developers lang={lang} />
<Compare lang={lang} />
<Install lang={lang} />
<Pricing lang={lang} />
