---
import { t, url } from '../i18n';
import { commands, permissions } from '../i18n/code';
import { esc } from '../i18n/util';
import type { Lang } from '../i18n/types';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).docs;
const cmdTable = `<div class="tbl"><table><thead><tr><th>${lang === 'tr' ? 'Komut' : 'Command'}</th><th>${lang === 'tr' ? 'Yetki' : 'Permission'}</th><th>${lang === 'tr' ? 'Açıklama' : 'Description'}</th></tr></thead><tbody>${
  commands.map((c) => `<tr><td><code>${esc(c.cmd)}</code></td><td><code>${esc(c.perm)}</code></td><td>${esc(c[lang])}</td></tr>`).join('')}</tbody></table></div>`;
const permTable = `<div class="tbl"><table><thead><tr><th>${lang === 'tr' ? 'Yetki' : 'Permission'}</th><th>${lang === 'tr' ? 'Açıklama' : 'Description'}</th></tr></thead><tbody>${
  permissions.map((p) => `<tr><td><code>${esc(p.node)}</code></td><td>${esc(p[lang])}</td></tr>`).join('')}</tbody></table></div>`;
const sections = d.sections.map((s) => ({ ...s, html: s.html.replace('{{commands}}', cmdTable).replace('{{permissions}}', permTable).replace(/<table>/g, (m) => m) }));
---
<div class="wrap docs">
  <aside class="toc">
    <nav aria-label={d.toc}>
      <p class="toc-title">{d.toc}</p>
      <ol>{sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}</ol>
      <a class="back" href={url('', lang)}>← {d.back}</a>
    </nav>
  </aside>
  <article class="content">
    <header>
      <h1>{d.title}</h1>
      <p class="muted">{d.lead}</p>
    </header>
    {sections.map((s) => (
      <section id={s.id}>
        <h2><a href={`#${s.id}`}>{s.title}</a></h2>
        <Fragment set:html={s.html} />
      </section>
    ))}
  </article>
</div>

<style>
  .docs { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 56px; padding: 56px 0 96px; }
  .toc nav { position: sticky; top: 84px; }
  .toc-title { font-size: 12px; color: var(--ink-3); margin-bottom: 10px; }
  .toc ol { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--line); }
  .toc a { display: block; padding: 5px 0 5px 14px; color: var(--ink-2); text-decoration: none; font-size: 14px; margin-left: -1px; border-left: 2px solid transparent; }
  .toc a:hover { color: var(--ink); border-left-color: var(--accent); }
  .back { margin-top: 20px; border: 0 !important; padding-left: 0 !important; }
  header { margin-bottom: 40px; padding-bottom: 28px; border-bottom: 1px solid var(--line); }
  h1 { font-size: clamp(2rem, 1.4rem + 2vw, 2.8rem); margin-bottom: 10px; }
  section { padding: 28px 0; border-bottom: 1px solid var(--line); }
  section h2 { font-size: 1.5rem; margin-bottom: 16px; }
  section h2 a { text-decoration: none; }
  section h2 a:hover::after { content: ' #'; color: var(--gold); }
  .content :global(p), .content :global(li) { color: var(--ink-2); max-width: 78ch; }
  .content :global(p + p), .content :global(pre + p), .content :global(p + pre), .content :global(pre + pre), .content :global(.tbl + p), .content :global(p + .tbl), .content :global(p + table), .content :global(table + p) { margin-top: 14px; }
  .content :global(ol), .content :global(ul) { padding-left: 1.3em; display: grid; gap: 6px; }
  .content :global(code) { color: var(--ink); background: var(--surface); padding: .05em .35em; border: 1px solid var(--line); font-size: .9em; }
  .content :global(pre) { background: var(--term-bg); color: var(--term-ink); padding: 16px 18px; overflow-x: auto; font-size: 12.5px; line-height: 1.6; border: 1px solid var(--line); box-shadow: 4px 4px 0 var(--line); margin: 14px 0; }
  .content :global(pre code) { background: none; border: 0; padding: 0; color: inherit; font-size: inherit; }
  .content :global(.tbl), .content :global(table) { overflow-x: auto; }
  .content :global(table) { width: 100%; border-collapse: collapse; font-size: 13.5px; display: block; }
  .content :global(.tbl table) { display: table; }
  .content :global(th), .content :global(td) { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .content :global(th) { color: var(--ink-3); font-weight: 600; font-size: 12.5px; }
  @media (max-width: 860px) { .docs { grid-template-columns: minmax(0, 1fr); gap: 24px; } .toc nav { position: static; } }
  .content { min-width: 0; }
</style>
