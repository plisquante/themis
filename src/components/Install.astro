---
import { t } from '../i18n';
import type { Lang } from '../i18n/types';
interface Props { lang: Lang }
const d = t(Astro.props.lang).install;
---
<section class="section" id="install">
  <div class="wrap">
    <div class="section-head"><div><h2>{d.title}</h2><p>{d.lead}</p></div></div>
    <ol class="steps">
      {d.steps.map((s, i) => (
        <li><span class="n" aria-hidden="true">{i + 1}</span><h3>{s.title}</h3><p>{s.body}</p></li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border: 1px solid var(--line); background: var(--surface); }
  li { padding: 26px 24px 28px; border-left: 1px solid var(--line); }
  li:first-child { border-left: 0; }
  .n { display: inline-grid; place-items: center; width: 30px; height: 30px; border: 2px solid var(--gold); color: var(--gold); font-weight: 700; margin-bottom: 18px; }
  h3 { margin-bottom: 8px; }
  p { color: var(--ink-2); font-size: 14px; }
  @media (max-width: 820px) { .steps { grid-template-columns: 1fr; } li { border-left: 0; border-top: 1px solid var(--line); } li:first-child { border-top: 0; } }
</style>
