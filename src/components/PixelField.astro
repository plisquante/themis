---
// Scattered pixels behind the hero, denser at the edges; they light up around the cursor.
---
<canvas class="pixel-field" aria-hidden="true"></canvas>

<style>
  .pixel-field { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.pixel-field');
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const CELL = 22;
    const SIZE = 12;
    let cols = 0, rows = 0, dpr = 1;
    let cells: { x: number; y: number; a: number; c: number; p: number }[] = [];
    let colors = ['#8e2236', '#cfb27a'];
    let mouse = { x: -999, y: -999 };
    let frame = 0;

    const readColors = () => {
      const s = getComputedStyle(document.documentElement);
      colors = [s.getPropertyValue('--pixel').trim(), s.getPropertyValue('--pixel-2').trim()];
    };

    // deterministic noise so the field doesn't jump between reloads
    const rand = (i: number) => { const x = Math.sin(i * 12.9898) * 43758.5453; return x - Math.floor(x); };

    const build = () => {
      const r = canvas.getBoundingClientRect();
      dpr = Math.min(2, devicePixelRatio || 1);
      canvas.width = r.width * dpr;
      canvas.height = r.height * dpr;
      cols = Math.ceil(r.width / CELL);
      rows = Math.ceil(r.height / CELL);
      cells = [];
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          const edgeX = Math.min(x, cols - 1 - x) / (cols / 2);
          const edgeY = (rows - 1 - y) / rows;
          const density = 0.55 * Math.pow(1 - edgeX, 6) + 0.4 * Math.pow(1 - edgeY, 7) + 0.006;
          const n = rand(x * 977 + y * 131);
          if (n < density) cells.push({ x, y, a: 0.14 + rand(x + y * 31) * 0.3, c: rand(y * 7 + x) > 0.82 ? 1 : 0, p: rand(x * 3 + y) * 6.28 });
        }
      }
    };

    const draw = (t: number) => {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      for (const c of cells) {
        const px = c.x * CELL + (CELL - SIZE) / 2;
        const py = c.y * CELL + (CELL - SIZE) / 2;
        const dx = px - mouse.x, dy = py - mouse.y;
        const near = Math.max(0, 1 - Math.sqrt(dx * dx + dy * dy) / 160);
        const twinkle = reduce ? 0 : Math.sin(t / 1400 + c.p) * 0.06;
        ctx.globalAlpha = Math.min(1, c.a + twinkle + near * 0.7);
        ctx.fillStyle = near > 0.35 ? colors[1] : colors[c.c];
        ctx.fillRect(px, py, SIZE, SIZE);
      }
      ctx.globalAlpha = 1;
    };

    const loop = (t: number) => { draw(t); frame = requestAnimationFrame(loop); };

    readColors();
    build();
    if (reduce) draw(0); else frame = requestAnimationFrame(loop);
    new ResizeObserver(() => { build(); if (reduce) draw(0); }).observe(canvas);
    const host = canvas.parentElement!;
    host.addEventListener('pointermove', (e) => { const r = canvas.getBoundingClientRect(); mouse = { x: e.clientX - r.left, y: e.clientY - r.top }; if (reduce) draw(0); });
    host.addEventListener('pointerleave', () => { mouse = { x: -999, y: -999 }; if (reduce) draw(0); });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelAnimationFrame(frame); else if (!reduce) frame = requestAnimationFrame(loop);
    });
  }
</script>
