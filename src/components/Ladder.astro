---
import { t } from '../i18n';
import type { Lang } from '../i18n/types';
interface Props { lang: Lang }
const d = t(Astro.props.lang).ladder;
---
<section class="section alt" id="ladders">
  <div class="wrap split">
    <div data-reveal>
      <h2>{d.title}</h2>
      <p class="muted lead">{d.lead}</p>
      <div class="controls">
        <button class="btn primary" type="button" data-ladder-add>{d.offence}</button>
        <button class="btn" type="button" data-ladder-reset>{d.reset}</button>
      </div>
      <p class="count" aria-live="polite"><span data-ladder-count>0</span> × /punish Steve spam</p>
    </div>
    <div class="ladder" data-ladder data-reveal style="--i:2">
      <p class="tpl">{d.template}</p>
      <ol>
        {d.steps.map((s, i) => (
          <li data-step={i} class={i === 0 ? 'next' : ''}>
            <span class="rung" aria-hidden="true"></span>
            <span class="label">{s.label}</span>
            <span class="detail">{s.detail}</span>
            <span class="badge">{d.current}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-ladder]').forEach((ladder) => {
    const section = ladder.closest('section')!;
    const steps = [...ladder.querySelectorAll<HTMLElement>('[data-step]')];
    const count = section.querySelector<HTMLElement>('[data-ladder-count]')!;
    let n = 0;
    const paint = () => {
      const next = Math.min(n, steps.length - 1);
      steps.forEach((s, i) => {
        s.classList.toggle('done', i < next);
        s.classList.toggle('next', i === next);
      });
      count.textContent = String(n);
    };
    section.querySelector('[data-ladder-add]')!.addEventListener('click', () => { n++; paint(); });
    section.querySelector('[data-ladder-reset]')!.addEventListener('click', () => { n = 0; paint(); });
    paint();
  });
</script>

<style>
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .lead { margin-top: 14px; max-width: 52ch; }
  .controls { display: flex; gap: 14px; margin-top: 28px; flex-wrap: wrap; }
  .count { margin-top: 18px; color: var(--ink-3); font-size: 13px; }
  .ladder { background: var(--surface); border: 1px solid var(--line); box-shadow: 6px 6px 0 var(--line); padding: 22px; }
  .tpl { font-size: 12px; color: var(--ink-3); margin-bottom: 14px; }
  ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  li {
    display: grid; grid-template-columns: 22px 90px 1fr auto; align-items: center; gap: 14px;
    padding: 12px 14px; border: 1px solid var(--line); background: var(--bg-2); transition: background-color .2s, border-color .2s, transform .2s;
  }
  .rung { width: 14px; height: 14px; border: 2px solid var(--ink-3); }
  .label { font-weight: 600; }
  .detail { color: var(--ink-2); font-size: 13px; }
  .badge { font-size: 11px; color: var(--accent-ink); background: var(--accent); padding: 2px 8px; visibility: hidden; }
  li.done { opacity: .55; }
  li.done .rung { background: var(--ink-3); }
  li.next { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, var(--surface)); transform: translateX(6px); }
  li.next .rung { border-color: var(--accent); background: var(--accent); }
  li.next .badge { visibility: visible; }
  @media (max-width: 860px) { .split { grid-template-columns: 1fr; gap: 32px; } }
  @media (max-width: 460px) { li { grid-template-columns: 18px 64px 1fr; } .badge { display: none; } }
</style>
