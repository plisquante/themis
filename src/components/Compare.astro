---
import { t } from '../i18n';
import type { Lang } from '../i18n/types';
interface Props { lang: Lang }
const d = t(Astro.props.lang).compare;
---
<section class="section alt" id="compare">
  <div class="wrap">
    <div class="section-head" data-reveal><div><h2>{d.title}</h2><p>{d.lead}</p></div></div>
    <div class="scroll" data-reveal tabindex="0" role="region" aria-label={d.title}>
      <table>
        <thead><tr><th scope="col"><span class="visually-hidden">Feature</span></th><th scope="col" class="us">{d.themis}</th><th scope="col">{d.typical}</th></tr></thead>
        <tbody>
          {d.rows.map((r) => <tr><th scope="row">{r.label}</th><td class="us">{r.themis}</td><td class="them">{r.typical}</td></tr>)}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .scroll { overflow-x: auto; border: 1px solid var(--line); background: var(--surface); }
  table { width: 100%; border-collapse: collapse; min-width: 560px; font-size: 14px; }
  th, td { text-align: left; padding: 14px 18px; border-bottom: 1px solid var(--line); vertical-align: top; }
  tbody tr:last-child > * { border-bottom: 0; }
  thead th { font: 600 13px 'Geist Variable', sans-serif; color: var(--ink-2); background: var(--bg-2); }
  thead th.us { color: var(--accent-ink); background: var(--accent); }
  tbody th { font-weight: 500; }
  td.us { color: var(--ink); background: color-mix(in srgb, var(--accent) 7%, transparent); font-weight: 600; }
  td.them { color: var(--ink-3); }
  tbody tr { transition: background-color .2s; }
  tbody tr:hover { background: var(--bg-2); }
</style>
