---
import Icon from './Icon.astro';
import { t, BUY_URL } from '../i18n';
import type { Lang } from '../i18n/types';
interface Props { lang: Lang }
const d = t(Astro.props.lang).pricing;
---
<section class="section alt" id="pricing">
  <div class="wrap split">
    <div class="card" data-reveal>
      <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/logo.png`} width="72" height="72" alt="" loading="lazy" />
      <p class="price"><span class="notranslate" translate="no">{d.price}</span><small>{d.per}</small></p>
      <ul>{d.includes.map((i) => <li><Icon name="check" />{i}</li>)}</ul>
      <a class="btn primary wide" href={BUY_URL}><Icon name="download" />{d.buy}</a>
      <p class="note">{d.note}</p>
    </div>
    <div data-reveal style="--i:2">
      <h2>{d.title}</h2>
      <p class="muted lead">{d.lead}</p>
      <h3 class="faq-title">{d.faqTitle}</h3>
      <div class="faq">
        {d.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </div>
    </div>
  </div>
</section>

<style>
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 56px; align-items: start; }
  .card { background: var(--surface); border: 1px solid var(--line); box-shadow: 8px 8px 0 var(--accent); padding: 32px; transition: transform .35s var(--ease-out), box-shadow .35s var(--ease-out); }
  .card:hover { transform: translate(-3px, -3px); box-shadow: 11px 11px 0 var(--accent); }
  .card img { border-radius: 50%; }
  .price { display: flex; flex-direction: column; margin: 20px 0 22px; }
  .price span { font: 700 3.4rem/1 'Geist Variable', sans-serif; letter-spacing: -.05em; }
  .price small { color: var(--ink-2); margin-top: 8px; font-size: 13px; }
  ul { list-style: none; padding: 0; margin: 0 0 26px; display: grid; gap: 10px; font-size: 14px; }
  li { display: flex; gap: 10px; align-items: flex-start; }
  li :global(svg) { width: 14px; height: 14px; color: var(--good); margin-top: 5px; flex: none; }
  .wide { width: 100%; }
  .note { margin-top: 14px; font-size: 12.5px; color: var(--ink-3); }
  .lead { margin-top: 14px; max-width: 50ch; }
  .faq-title { margin: 40px 0 12px; }
  details { border-top: 1px solid var(--line); }
  details:last-child { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; padding: 16px 0; font-weight: 600; list-style: none; display: flex; justify-content: space-between; gap: 12px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; color: var(--gold); font-weight: 700; }
  details[open] summary::after { content: '−'; }
  details p { padding: 0 0 18px; color: var(--ink-2); font-size: 14px; }
  @media (max-width: 860px) { .split { grid-template-columns: 1fr; } }
</style>
