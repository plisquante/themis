---
import Wordmark from './Wordmark.astro';
import PixelField from './PixelField.astro';
import Icon from './Icon.astro';
import { t, url, asset, BUY_URL } from '../i18n';
import type { Lang } from '../i18n/types';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).hero;
---
<section class="hero">
  <PixelField />
  <div class="aura" aria-hidden="true"></div>
  <div class="wrap inner">
    <a class="pill h1" href={url(d.pillHref, lang)}><span class="dot" aria-hidden="true"></span>{d.pill}<Icon name="arrow" /></a>
    <h1 class="visually-hidden">Themis — {d.title}</h1>
    <img class="seal h2" src={asset('logo.png')} width="88" height="88" alt="" />
    <Wordmark />
    <p class="title h3">{d.title}</p>
    <p class="lead h4">{d.lead}</p>
    <div class="ctas h5">
      <a class="btn primary glow" href={BUY_URL}><Icon name="download" />{d.cta}</a>
      <a class="btn" href="#demo"><Icon name="play" />{d.demo}</a>
    </div>
    <dl class="stats h6">
      {d.stats.map((s) => <div><dt>{s.label}</dt><dd data-count={s.value}>{s.value}</dd></div>)}
    </dl>
  </div>
</section>

<script>
  // Count numeric stats up when they come into view.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
    const m = el.dataset.count!.match(/^(\D*)(\d+)(.*)$/);
    if (!m || reduce) return;
    const [, pre, num, post] = m;
    const target = Number(num);
    const delay = document.documentElement.classList.contains('intro-play') ? 2300 : 900;
    el.textContent = pre + '0' + post;
    setTimeout(() => {
      const start = performance.now();
      const step = (now: number) => {
        const k = Math.min(1, (now - start) / 1100);
        el.textContent = pre + Math.round(target * (1 - Math.pow(1 - k, 3))) + post;
        if (k < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }, delay);
  });
</script>

<style>
  .hero { position: relative; overflow: hidden; padding: clamp(48px, 7vw, 96px) 0 clamp(56px, 7vw, 96px); isolation: isolate; }
  .aura {
    position: absolute; inset: -20% -10% auto; height: 120%; z-index: -1; pointer-events: none;
    background:
      radial-gradient(60% 45% at 50% 38%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 70%),
      radial-gradient(30% 25% at 50% 36%, color-mix(in srgb, var(--gold) 10%, transparent), transparent 70%);
  }
  .inner { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .pill {
    display: inline-flex; align-items: center; gap: 10px; margin-bottom: clamp(28px, 4vw, 44px);
    padding: 7px 14px; font-size: 13px; color: var(--gold-2); text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--gold) 40%, transparent); background: color-mix(in srgb, var(--bg) 75%, transparent);
    transition: border-color .2s, transform .2s var(--ease-out);
  }
  .pill:hover { border-color: var(--gold); transform: translateY(-2px); }
  .pill :global(svg) { width: 14px; height: 14px; transition: transform .2s var(--ease-out); }
  .pill:hover :global(svg) { transform: translateX(3px); }
  .dot { width: 7px; height: 7px; background: var(--good); box-shadow: 0 0 0 0 var(--good); animation: pulse 2.2s ease-out infinite; }
  .seal { width: 88px; height: 88px; border-radius: 50%; margin-bottom: 26px;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--gold) 45%, transparent), 0 0 48px color-mix(in srgb, var(--glow) 60%, transparent); }
  .title {
    margin-top: clamp(30px, 4.5vw, 52px); font: 650 clamp(1.6rem, 1rem + 2.4vw, 2.6rem)/1.12 'Geist Variable', sans-serif;
    letter-spacing: -.035em; max-width: 22ch;
    background: linear-gradient(180deg, var(--ink), color-mix(in srgb, var(--gold-2) 70%, var(--ink)));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .lead { margin-top: 16px; max-width: 62ch; color: var(--ink-2); }
  .ctas { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; margin-top: 34px; }
  .glow { position: relative; }
  .glow::after { content: ''; position: absolute; inset: -1px; box-shadow: 0 0 28px color-mix(in srgb, var(--accent) 65%, transparent); opacity: .7;
    pointer-events: none; animation: breathe 3.2s ease-in-out infinite; }
  .stats {
    display: grid; grid-template-columns: repeat(3, 1fr); margin: clamp(48px, 7vw, 80px) 0 0; width: 100%; max-width: 900px;
    border-top: 1px solid var(--line); text-align: left;
    background: linear-gradient(to bottom, color-mix(in srgb, var(--bg) 92%, transparent), color-mix(in srgb, var(--bg) 70%, transparent));
  }
  .stats div { padding: 18px 20px 0; border-left: 1px solid var(--line); display: flex; flex-direction: column; gap: 4px; }
  .stats div:first-child { border-left: 0; padding-left: 0; }
  .stats dd { order: -1; margin: 0; font: 650 1.8rem 'Geist Variable', sans-serif; letter-spacing: -.03em; color: var(--gold-2); font-variant-numeric: tabular-nums; }
  .stats dt { font-size: 13px; color: var(--ink-2); }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero { --base: 150ms; }
    :global(html.intro-play) .hero { --base: 1100ms; }
    :global(html.js) :is(.h1, .h2, .h3, .h4, .h5, .h6) { animation: up .9s var(--ease-out) both; }
    :global(html.js) .h2 { animation: seal 1s var(--ease-spring) both; animation-delay: var(--base); }
    :global(html.js) .h1 { animation-delay: calc(var(--base) + 1200ms); }
    :global(html.js) .h3 { animation-delay: calc(var(--base) + 1300ms); }
    :global(html.js) .h4 { animation-delay: calc(var(--base) + 1420ms); }
    :global(html.js) .h5 { animation-delay: calc(var(--base) + 1540ms); }
    :global(html.js) .h6 { animation-delay: calc(var(--base) + 1660ms); }
  }
  @keyframes up { from { opacity: 0; transform: translateY(22px); filter: blur(4px); } to { opacity: 1; transform: none; filter: none; } }
  @keyframes seal { from { opacity: 0; transform: scale(.5) rotate(-30deg); } to { opacity: 1; transform: none; } }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--good) 70%, transparent); } 100% { box-shadow: 0 0 0 10px transparent; } }
  @keyframes breathe { 50% { opacity: .25; } }
  @media (max-width: 680px) {
    .stats { grid-template-columns: 1fr; }
    .stats div { border-left: 0; padding: 14px 0; border-bottom: 1px solid var(--line); }
    .seal { width: 64px; height: 64px; }
  }
</style>
