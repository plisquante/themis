---
import Wordmark from './Wordmark.astro';
import PixelField from './PixelField.astro';
import Icon from './Icon.astro';
import { t, url, BUY_URL } from '../i18n';
import type { Lang } from '../i18n/types';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).hero;
---
<section class="hero">
  <PixelField />
  <div class="wrap inner">
    <a class="pill" href={url(d.pillHref, lang)}>{d.pill}<Icon name="arrow" /></a>
    <h1 class="visually-hidden">Themis</h1>
    <Wordmark />
    <p class="title">{d.title}</p>
    <p class="lead">{d.lead}</p>
    <div class="ctas">
      <a class="btn primary" href={BUY_URL}><Icon name="download" />{d.cta}</a>
      <a class="btn" href="#demo"><Icon name="play" />{d.demo}</a>
    </div>
    <dl class="stats">
      {d.stats.map((s) => <div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}
    </dl>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; padding: clamp(56px, 8vw, 112px) 0 clamp(56px, 7vw, 96px); }
  .inner { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; text-align: center; }
  .pill {
    display: inline-flex; align-items: center; gap: 10px; margin-bottom: clamp(36px, 6vw, 72px);
    padding: 7px 14px; font-size: 13px; color: var(--gold); text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--gold) 45%, transparent); background: color-mix(in srgb, var(--bg) 70%, transparent);
  }
  .pill :global(svg) { width: 14px; height: 14px; }
  .pill:hover { border-color: var(--gold); }
  .title {
    margin-top: clamp(32px, 5vw, 56px); font: 600 clamp(1.5rem, 1rem + 2.2vw, 2.4rem)/1.15 'Geist Variable', sans-serif;
    letter-spacing: -.03em; max-width: 22ch;
  }
  .lead { margin-top: 16px; max-width: 64ch; color: var(--ink-2); }
  .ctas { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; margin-top: 32px; }
  .stats {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin: clamp(48px, 7vw, 80px) 0 0; width: 100%; max-width: 880px;
    border-top: 1px solid var(--line); text-align: left;
    background: linear-gradient(to bottom, color-mix(in srgb, var(--bg) 92%, transparent), color-mix(in srgb, var(--bg) 70%, transparent));
  }
  .stats div { padding: 18px 20px 0; border-left: 1px solid var(--line); display: flex; flex-direction: column; gap: 4px; }
  .stats dd { order: -1; }
  .stats div:first-child { border-left: 0; padding-left: 0; }
  .stats dd { margin: 0; font: 600 1.6rem 'Geist Variable', sans-serif; letter-spacing: -.03em; color: var(--ink); }
  .stats dt { font-size: 13px; color: var(--ink-2); }
  @media (max-width: 680px) {
    .stats { grid-template-columns: 1fr; }
    .stats div { border-left: 0; padding: 14px 0; border-bottom: 1px solid var(--line); }
  }
</style>
